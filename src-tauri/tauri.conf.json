{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigiManager",
  "version": "0.2.2",
  "identifier": "com.digibyte.digimanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DigiManager",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 DigiByte. All rights reserved.",
    "shortDescription": "A DigiByte Library Manager"
  }
}
